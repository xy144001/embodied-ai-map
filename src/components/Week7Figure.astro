---
interface Props { id: "inference" | "rvq" | "training"; caption: string }
const {id,caption}=Astro.props;
const figures={inference:["固定码本原型：一次动作块如何生成",1000],rvq:["32 步动作如何变成 16 个码 ID",1010],training:["三阶段训练与推理：谁在学习，谁提供码",1060]} as const;
const [title,height]=figures[id];
const src=import.meta.env.BASE_URL.replace(/\/$/,"")+"/model-architecture/week7/"+id+".svg";
---
<figure class="w6-figure">
  <div class="w6-figure-tools"><a href={src} target="_blank" rel="noopener">打开并放大结构图 ↗</a><a href={src} download={"Codebook-Memory-WAM-Week7-"+id+".svg"}>下载 SVG</a></div>
  <div class="w6-figure-scroll" tabindex="0" role="region" aria-label={title+"，窄屏可横向滚动"}><a href={src} target="_blank" rel="noopener" aria-label={title+"，打开矢量原图"}><img src={src} width="1120" height={height} alt={title+"。"+caption} loading="lazy" decoding="async" /></a></div>
  <figcaption>{caption}</figcaption>
</figure>
