---
import data from "../data/week7-codebook.json";
const format=(v:number)=>v>=1?v.toFixed(2):v.toPrecision(3);
const curves=data.curves.map(curve=>{
  const max=curve.points[0].value*1.08;
  const px=(step:number)=>48+step/6000*262;
  const py=(v:number)=>184-v/max*140;
  return {...curve,
    line:curve.points.map(p=>`${px(p.step)},${py(p.value)}`).join(" "),
    dots:curve.points.map(p=>({x:px(p.step),y:py(p.value)})),
    ticks:[0,max/2,max].map(v=>({label:format(v),y:py(v)})),
    xTicks:[0,3000,6000].map(step=>({label:step,x:px(step)})),
    selectedX:px(curve.selectedStep),selectedY:py(curve.selectedValue)
  };
});
---
<div class="w7-curves">
  {curves.map(curve=><figure>
      <h3>{curve.label}</h3><p>{curve.metric}</p>
      <svg viewBox="0 0 330 225" role="img" aria-labelledby={curve.id+"-curve-title"}>
        <title id={curve.id+"-curve-title"}>{curve.metric}：第 0 步 {format(curve.points[0].value)}，开发最优第 {curve.selectedStep} 步 {curve.selectedValue.toFixed(6)}。完整数值见下方表格。</title>
        {curve.ticks.map(t=><g><line x1="48" y1={t.y} x2="310" y2={t.y} stroke="#354b65" /><text x="41" y={t.y+4} text-anchor="end">{t.label}</text></g>)}
        <line x1="48" y1="44" x2="48" y2="184" stroke="#829dbb" />
        <polyline points={curve.line} fill="none" stroke="#a4dcc5" stroke-width="2.5" />
        {curve.dots.map(p=><circle cx={p.x} cy={p.y} r="2.3" fill="#a4dcc5" />)}
        <circle cx={curve.selectedX} cy={curve.selectedY} r="5" fill="#d4bdff" stroke="#0b1422" stroke-width="2" />
        {curve.xTicks.map(t=><text x={t.x} y="204" text-anchor="middle">{t.label}</text>)}
        <text x="310" y="222" text-anchor="end">训练步数</text>
      </svg>
      <figcaption>选用第 {curve.selectedStep.toLocaleString("en-US")} 步：<strong>{curve.selectedValue.toFixed(6)}</strong></figcaption>
    </figure>)}
</div>
<p class="w6-meta">每张图使用独立纵轴；三个指标的定义不同，数值大小不能用来给模块排名。点为每 500 步一次的开发评估，连线仅连接观测点。</p>
<details><summary>展开全部曲线数值（便于复核）</summary><div class="w6-table-wrap" tabindex="0" role="region" aria-label="各阶段每 500 步开发指标"><table><caption>同一固定开发面板上的指标</caption><thead><tr><th scope="col">步数</th>{data.curves.map(c=><th scope="col">{c.metric}</th>)}</tr></thead><tbody>{data.curves[0].points.map((p,i)=><tr><th scope="row">{p.step}</th>{data.curves.map(c=><td>{c.points[i].value.toFixed(6)}</td>)}</tr>)}</tbody></table></div></details>
