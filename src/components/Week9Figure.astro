---
interface Props {id:"evolution"|"training";caption:string}
const {id,caption}=Astro.props;
const height=id==="evolution"?1110:1090;
const title=id==="evolution"?"从独立 Prior 到官方 G0.5 的路线演变":"官方 G0.5 Base 的训练与部署边界";
const src=import.meta.env.BASE_URL.replace(/\/$/,"")+"/model-architecture/week9/"+id+".svg";
---
<figure class="w6-figure"><div class="w6-figure-tools"><a href={src} target="_blank" rel="noopener">放大结构图 ↗</a><a href={src} download={"Week9-"+id+".svg"}>下载 SVG</a></div><div class="w6-figure-scroll" tabindex="0" role="region" aria-label={title+"，窄屏可横向滚动"}><a href={src} target="_blank" rel="noopener"><img src={src} width="1120" height={height} alt={title+"。"+caption} loading="lazy" /></a></div><figcaption>{caption}</figcaption></figure>
