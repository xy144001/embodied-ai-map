---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const assetRoot = base + "/model-architecture/assets/week2-examples/";
const examples = [
  {
    id: "example-dit4dit",
    title: "DiT4DiT：VLA 与 Decoupled WBC",
    focus: "沿着 Video DiT、Action DiT 和下层控制器，讲解任务动作参考如何交给机器人执行。",
    images: [
      { file: "dit4dit-overview.webp", title: "整体架构", alt: "DiT4DiT 整体架构讲解图：输入、Video DiT、Action DiT、Decoupled WBC 与 G1 的关系" },
      { file: "dit4dit-details.webp", title: "关键模块运行细节", alt: "DiT4DiT 细节讲解图：视觉与语言编码、未来表征、动作块生成和下层控制" },
    ],
  },
  {
    id: "example-cosmos3",
    title: "Cosmos3-Nano-Policy-DROID：固定底座机械臂",
    focus: "对照 Reasoner、Generator 和执行层，讨论这张 DROID 示例中的动作表示与控制接口。",
    images: [
      { file: "cosmos3-droid-overview.webp", title: "整体架构", alt: "Cosmos3-Nano-Policy-DROID 整体架构讲解图：多模态输入、双塔模型与 Franka 机械臂执行层" },
      { file: "cosmos3-droid-details.webp", title: "关键模块运行细节", alt: "Cosmos3-Nano-Policy-DROID 细节讲解图：Reasoner 条件、动作扩散与关节控制器" },
    ],
  },
  {
    id: "example-groot-sonic",
    title: "GR00T N1.7 + SONIC：任务策略与运动控制",
    focus: "对照 VLA 内部的两个系统与外部 SONIC，讲解运动表示、动作生成和身体反馈的分工。",
    images: [
      { file: "groot-sonic-overview.webp", title: "整体架构", alt: "GR00T N1.7 与 SONIC 整体架构讲解图：VLA、运动接口、全身控制器与 G1" },
      { file: "groot-sonic-details.webp", title: "关键模块运行细节", alt: "GR00T N1.7 与 SONIC 细节讲解图：视觉语言特征、动作专家、运动 token 与低层控制" },
    ],
  },
];
---

<section class="weekly-question week2-examples" id="teaching-examples" aria-labelledby="teaching-examples-title">
  <div class="question-number">THREE EXAMPLES · FROM VLA TO EXECUTION</div>
  <h2 id="teaching-examples-title">三个讲解示例：从模型架构到机器人执行</h2>
  <p>每个示例先看整体架构，再看关键模块的运行细节。点击图片可打开大图，便于查看文字、维度和箭头。</p>
  <nav class="example-jumps" aria-label="选择讲解示例">
    {examples.map((example, index) => (
      <a href={"#" + example.id}>示例 {index + 1} · {index === 0 ? "DiT4DiT" : index === 1 ? "Cosmos3" : "GR00T + SONIC"}</a>
    ))}
  </nav>
  {examples.map((example, exampleIndex) => (
    <article class="teaching-example" id={example.id} aria-labelledby={example.id + "-title"}>
      <h3 id={example.id + "-title"}>示例 {exampleIndex + 1} · {example.title}</h3>
      <p>{example.focus}</p>
      {example.images.map((diagram, diagramIndex) => (
        <figure class="example-figure">
          <a class="example-image-link" href={assetRoot + diagram.file} target="_blank" rel="noopener" aria-label={diagram.alt + "，打开大图"}>
            <img
              src={assetRoot + diagram.file}
              alt={diagram.alt}
              width="1448"
              height="1086"
              loading="lazy"
              decoding="async"
            />
          </a>
          <figcaption>
            <span>图 {exampleIndex + 1}.{diagramIndex + 1} · {diagram.title}</span>
            <a href={assetRoot + diagram.file} target="_blank" rel="noopener">打开大图 ↗</a>
          </figcaption>
        </figure>
      ))}
    </article>
  ))}
  <p class="source-line">阅读时结合前文的接口与频率说明；图中的步数、状态字段和模块职责需对应到所选模型与部署配置。</p>
</section>

<style>
  .week2-examples { margin-top: 38px; }
  .example-jumps { display: flex; flex-wrap: wrap; gap: 10px; margin: 22px 0 28px; }
  .example-jumps a { display: inline-flex; align-items: center; min-height: 44px; padding: 9px 14px; background: #15263e; border: 1px solid #49688f; border-radius: 5px; font-size: 14px; text-decoration: none; }
  .example-jumps a:hover { background: #213c60; color: #fff; }
  .teaching-example { scroll-margin-top: 96px; }
  .teaching-example + .teaching-example { margin-top: 38px; padding-top: 8px; border-top: 1px solid #344760; }
  .example-figure { margin: 24px 0 30px; border: 1px solid #425b7a; border-radius: 6px; background: #111e30; }
  .example-image-link { display: block; background: #fff; border-radius: 5px 5px 0 0; }
  .example-image-link img { display: block; width: 100%; height: auto; max-width: 100%; object-fit: contain; border-radius: 5px 5px 0 0; }
  .example-figure figcaption { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px 18px; padding: 12px 16px; color: #c6d8f0; font-size: 14px; line-height: 1.8; }
  .example-figure figcaption a { padding: 6px 0; }
  .example-jumps a:focus-visible, .example-image-link:focus-visible, .example-figure figcaption a:focus-visible { outline: 3px solid #c4ddff; outline-offset: 4px; }
  @media (max-width: 650px) {
    .example-jumps { flex-direction: column; }
    .example-figure figcaption { padding: 10px 12px; }
  }
</style>
