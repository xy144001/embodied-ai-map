---
import ModelSectionNav from "../components/ModelSectionNav.astro";
interface Props {
  title: string;
  description: string;
  section: "problems" | "tasks";
  week: 1 | 2 | 3;
}
const { title, description, section, week } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const root = base + "/model-architecture";
const label = section === "problems" ? "问题" : "任务";
const weekRoot = root + "/" + section + "/";
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · 具身机器人技术地图</title>
    <link rel="stylesheet" href={root + "/module-sections.css?v=20260919-memory"} />
    <link rel="stylesheet" href={root + "/weekly-sections.css"} />
  </head>
  <body class="subpage weekly-page">
    <a class="weekly-skip" href="#main">跳转到正文</a>
    <header class="top">
      <div class="brand">MODEL<b>/</b>ATLAS</div>
      <a class="home-link" href={base + "/"}>← 返回技术地图</a>
      <div class="status">@xy144001 · {label} · Week {week}</div>
    </header>
    <ModelSectionNav active={section} detail />
    <main id="main" class:list={["section-main", "weekly-main", { "weekly-tasks": section === "tasks" }]}>
      <nav class="week-tabs" aria-label={label + "周次"}>
        <a class:list={{ active: week === 1 }} href={weekRoot} aria-current={week === 1 ? "page" : undefined}>Week 1</a>
        <a class:list={{ active: week === 2 }} href={weekRoot + "week2/"} aria-current={week === 2 ? "page" : undefined}>Week 2</a>
        {section === "problems" && <a class:list={{ active: week === 3 }} href={weekRoot + "week3/"} aria-current={week === 3 ? "page" : undefined}>Week 3</a>}
      </nav>
      <slot />
    </main>
    <footer class="weekly-footer"><a href={weekRoot}>← Week 1 {label}</a><a href="#main">返回页首 ↑</a></footer>
  </body>
</html>
