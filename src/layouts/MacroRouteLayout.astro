---
interface Props { title: string; description: string; detail?: boolean }
const { title, description, detail = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const root = `${base}/model-architecture`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · 宏观路线 · 具身机器人技术地图</title>
    <link rel="stylesheet" href={`${root}/module-sections.css?v=20260914-routes`} />
    <link rel="stylesheet" href={`${root}/routes/routes.css`} />
  </head>
  <body class="subpage mr-page">
    <a class="mr-skip" href="#main">跳转到正文</a>
    <header class="top">
      <div class="brand">MODEL<b>/</b>ATLAS</div>
      <a class="home-link" href={detail ? `${root}/routes/` : `${root}/`}>{detail ? "← 全部宏观路线" : "← 返回模型架构"}</a>
      <div class="status">@xy144001 · 宏观路线</div>
    </header>
    <nav class="module-tabs" aria-label="模型架构组版块">
      <a href={`${root}/`}>架构</a><a href={`${root}/problems/`}>问题</a><a href={`${root}/tasks/`}>任务</a><a href={`${root}/robots/`}>机器人</a>
      <a class="breakdown-tab" href={`${root}/breakdown/`}>拆解模型</a>
      <a class="macro-tab active" href={`${root}/routes/`} aria-current={detail ? "location" : "page"}>宏观路线</a>
    </nav>
    <slot />
    <footer class="mr-footer"><a href={`${root}/routes/`}>宏观路线</a><span>模型架构组 · 从未来判断，回到可验证的问题。</span><a href="#main">返回页首 ↑</a></footer>
  </body>
</html>
