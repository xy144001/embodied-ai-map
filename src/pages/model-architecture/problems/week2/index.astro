  openhlmCode: "https://github.com/OpenHLM-project/OpenHLM/blob/main/src/openpi4OpenHLM/examples/unitree_g1/sonic_g1_env.py",
  openhlmTeleop: "https://github.com/OpenHLM-project/OpenHLM/blob/main/src/GR00T-WholeBodyControl4OpenHLM/robot_data_collection.md",
