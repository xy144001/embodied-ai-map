---
import RobotLayout from "../../../layouts/RobotLayout.astro";
import dossiers from "../../../data/robot-dossiers.json";
const { robots, checkedAt, fx } = dossiers;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const money = (p: { amount: number | null; currency: string }) => p.amount === null ? "需询价" : `${p.currency === "CNY" ? "¥" : "US$"}${p.amount.toLocaleString("en-US", { maximumFractionDigits: 2 })}`;
const kinds = [{ id: "all", label: "全部" }, { id: "biped", label: "双足人形" }, { id: "wheeled", label: "轮式双臂" }, { id: "dual", label: "固定双臂" }, { id: "single", label: "单臂" }];
---
<RobotLayout title="机器人选型" description="11 个科研机器人平台的硬件、VLA/WAM 兼容性、中美公开报价与采购条件。">
  <main id="main" class="robot-main">
    <header class="robot-heading">
      <div><p class="robot-eyebrow">ROBOT PLATFORMS · 11 个研究平台</p><h1>从模型，走向本体。</h1><p class="robot-intro">比较硬件、控制接口与模型生态，找到适合实验的机器人。</p></div>
      <p class="research-date">资料核对<br /><time datetime={checkedAt}>{checkedAt}</time><span>公开报价与历史线索分别标注</span></p>
    </header>
    <details class="reading-guide">
      <summary>怎样读价格和“兼容性”？</summary>
      <div class="guide-grid">
        <section><h2>价格要对齐配置</h2><p>卡片优先展示本次找到的公开现价；没有现价时显示带日期的历史线索或“需询价”。标价不是保证成交的最低价。中国、美国、国际直邮分别标记；基础版、科研版、不同手与计算模块不直接混比。</p><p>价格表保留原币种。美元折算仅供预算：1 USD ≈ {fx.usdCny} CNY，使用 <a href={fx.url} target="_blank" rel="noreferrer">{fx.date} 人民币中间价</a>。实际支付汇率、税费、运费、维修回运与开发附件另计。</p></section>
        <section><h2>有接口，不等于即插即用</h2><p>“论文真机对照”说明研究团队做过实机实验；“公开真机流程”说明存在可读的采集、训练或部署代码；“仿真支持”只覆盖相应环境。检查点还必须匹配机械臂、末端、相机、动作单位与控制频率。</p><p>原调研中的主观星级和综合分数未作为客观排名使用。各平台优势、限制与建议实验路径属于基于来源的选型分析。</p></section>
      </div>
    </details>
    <section class="robot-controls" aria-label="筛选机器人">
      <div class="robot-filters" role="group" aria-label="机器人类型">{kinds.map((kind) => <button type="button" data-kind={kind.id} aria-pressed={kind.id === "all"}>{kind.label}</button>)}</div>
      <label class="robot-search"><span>搜索型号、公司或研究方向</span><input id="robot-search" type="search" placeholder="例如 G1、双臂、DROID" autocomplete="off" /></label>
    </section>
    <p id="robot-count" class="result-count" aria-live="polite">显示 8 / {robots.length} 个平台</p>
    <section class="robot-grid" aria-label="机器人卡片">
      {robots.map((robot, index) => {
        const price = robot.prices[robot.reference];
        return <article class="robot-card" data-robot-kind={robot.kind} data-search={`${robot.name} ${robot.organization} ${robot.category} ${robot.focus} ${robot.compatibility.map(c => c.model).join(" ")}`.toLowerCase()} hidden={index >= 8}>
          <div class="card-meta"><span>{String(index + 1).padStart(2, "0")} / {robot.category}</span><span>{robot.focus}</span></div>
          <h2><a href={`${base}/model-architecture/robots/${robot.id}/`}>{robot.name}</a></h2>
          <p class="robot-company">{robot.organization}</p>
          <p class="card-summary">{robot.summary}</p>
          <div class="card-price"><span>{price.type.includes("历史") ? "历史价格参考" : "公开报价参考"}</span><strong>{money(price)}</strong><p>{price.market} · {price.type}</p><p>{price.config}</p></div>
          <p class="card-price-hint">{robot.priceHint}</p>
          <div class="card-bottom"><span>{robot.status}</span><a href={`${base}/model-architecture/robots/${robot.id}/`} aria-label={`查看 ${robot.name} 详细调研`}>查看详细调研 →</a></div>
        </article>;
      })}
    </section>
    <div id="robot-empty" class="robot-empty" hidden><h2>没有匹配的平台</h2><p>换一个型号、品牌或研究方向，或清除筛选。</p><button type="button" id="robot-reset">清除筛选</button></div>
    <button class="robot-more" id="robot-more" type="button">再显示 3 个平台</button>
    <noscript><style>.robot-card[hidden]{display:flex!important}.robot-controls,.result-count,.robot-more{display:none!important}</style><p class="robot-note">已显示全部平台。点击卡片即可阅读独立详情页。</p></noscript>
  </main>
</RobotLayout>
<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".robot-card"));
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-kind]"));
  const search = document.querySelector<HTMLInputElement>("#robot-search")!;
  const more = document.querySelector<HTMLButtonElement>("#robot-more")!;
  const count = document.querySelector<HTMLElement>("#robot-count")!;
  const empty = document.querySelector<HTMLElement>("#robot-empty")!;
  let active = "all";
  let limit = 8;
  function render() {
    const query = search.value.trim().toLowerCase();
    const matches = cards.filter(card => (active === "all" || card.dataset.robotKind === active) && (card.dataset.search || "").includes(query));
    cards.forEach(card => { card.hidden = true; });
    matches.slice(0, limit).forEach(card => { card.hidden = false; });
    filters.forEach(button => button.setAttribute("aria-pressed", String(button.dataset.kind === active)));
    count.textContent = `显示 ${Math.min(limit, matches.length)} / ${matches.length} 个平台`;
    const remaining = matches.length - limit;
    more.hidden = remaining <= 0;
    more.textContent = `再显示 ${Math.min(8, Math.max(0, remaining))} 个平台`;
    empty.hidden = matches.length > 0;
    return matches;
  }
  filters.forEach(button => button.addEventListener("click", () => { active = button.dataset.kind || "all"; limit = 8; render(); }));
  search.addEventListener("input", () => { limit = 8; render(); });
  more.addEventListener("click", () => { const next = limit; limit += 8; const matches = render(); matches[next]?.querySelector<HTMLAnchorElement>("h2 a")?.focus({ preventScroll: true }); });
  document.querySelector("#robot-reset")?.addEventListener("click", () => { active = "all"; search.value = ""; limit = 8; render(); search.focus(); });
  render();
</script>
