---
import MacroRouteLayout from "../../../layouts/MacroRouteLayout.astro";
import MacroCitations from "../../../components/MacroCitations.astro";
import MacroDataProgress from "../../../components/MacroDataProgress.astro";
import data from "../../../data/macro-routes.json";
export function getStaticPaths() { return data.routes.map(route => ({ params: { id: route.id }, props: {route} })); }
type Route = (typeof data.routes)[number];
interface Props {route: Route}
const { route } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const root = `${base}/model-architecture`;
const number = String(data.routes.findIndex(r=>r.id===route.id)+1).padStart(2,"0");
const sources = data.sources as Record<string, {title:string;url:string;kind:string;date:string}>;
const progress = Object.entries(data.progress).find(([id])=>id===route.id)?.[1];
const ids = [...new Set([...route.beliefs,...route.evidence,...(progress ? [progress,...progress.stages] : [])].flatMap(item=>item.refs))];
const sections=[...(progress ? [["progress","当前进展与数据"]] : []),["beliefs","最看重什么"],["path","未来怎样发展"],["evidence","已有的尝试"],["differences","和其他路线的联系"],["questions","还需要回答什么"],["research","对我们的启发"],["sources","原始资料"]];
const related = route.related.map(id => data.routes.find(r=>r.id===id)!);
---
<MacroRouteLayout title={`${route.person} · ${route.title}`} description={route.thesis} detail>
  <main id="main" class="mr-main mr-detail">
    <header class="mr-detail-hero">
      <p class="mr-eyebrow">ROUTE {number} / 09 · {route.person}</p><h1>{route.title}</h1>
      <p class="mr-person">{route.org}</p><p class="mr-thesis">{route.thesis}</p>
      <ul class="mr-tags" aria-label="路线关键词">{route.tags.map(tag=><li>{tag}</li>)}</ul>
      <p class="mr-detail-date">资料核对 <time datetime={data.updated}>{data.updated}</time></p>
    </header>
    <div class="mr-detail-grid">
      <aside class="mr-sidebar"><nav aria-label="本页目录"><p>本页阅读</p>{sections.map(([id,label],i)=><a href={`#${id}`}><span>{id==="progress" ? "•" : String(progress ? i : i+1).padStart(2,"0")}</span>{label}</a>)}</nav><a class="mr-back" href={`${root}/routes/`}>← 全部 9 条路线</a></aside>
      <div class="mr-article">
        <p class="mr-scope">{route.scope}</p>
        {progress && <MacroDataProgress progress={progress}/>}
        <section id="beliefs" class="mr-article-section"><p class="mr-section-label">01 / CORE VIEW</p><h2>这条路线最看重什么？</h2>{route.beliefs.map(item=><article class="mr-belief"><h3>{item.title}</h3><p>{item.text}</p><MacroCitations refs={item.refs}/></article>)}</section>
        <section id="path" class="mr-article-section"><p class="mr-section-label">02 / DEVELOPMENT PATH</p><h2>这条路，接下来怎样走？</h2><p class="mr-analysis-note">以下步骤是本站根据公开观点整理的理解，帮助串起这条路线的思路，并非官方时间表。</p><ol class="mr-path">{route.future.map((item,index)=><li><span aria-hidden="true">{String(index+1).padStart(2,"0")}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></li>)}</ol></section>
        <section id="evidence" class="mr-article-section"><p class="mr-section-label">03 / EVIDENCE</p><h2>已经有哪些尝试？</h2><div class="mr-evidence">{route.evidence.map(item=><article><span class="mr-evidence-date">{item.date}</span><h3>{item.title}</h3><p>{item.text}</p><p class="mr-limit"><strong>怎样理解</strong>{item.limit}</p><MacroCitations refs={item.refs}/></article>)}</div></section>
        <section id="differences" class="mr-article-section"><p class="mr-section-label">04 / CONNECTIONS</p><h2>和其他路线有哪些联系？</h2><p class="mr-analysis-note">本站分析</p><p>{route.difference}</p><nav class="mr-related" aria-label="相关路线">{related.map(r=><a href={`${root}/routes/${r.id}/`}>{r.person} <span aria-hidden="true">↗</span></a>)}</nav></section>
        <section id="questions" class="mr-article-section"><p class="mr-section-label">05 / OPEN QUESTIONS</p><h2>还需要回答什么？</h2><p class="mr-analysis-note">带着这些问题看后续进展，可以判断这条路线是否正在接近自己的目标。</p><ol class="mr-questions">{route.questions.map(q=><li>{q}</li>)}</ol></section>
        <section id="research" class="mr-article-section"><p class="mr-section-label">06 / OUR RESEARCH</p><h2>我们能从中得到什么启发？</h2><p class="mr-analysis-note">以下是本站从这条路线延伸出的研究建议。</p><div class="mr-experiment"><h3>可以怎样试一试</h3><p>{route.experiment}</p><h3>看哪些结果</h3><p>{route.metrics}</p><h3>再看模型时，留意什么</h3><p>{route.connection}</p><a href={`${root}/`}>返回架构，对照模型 →</a></div></section>
        <section id="sources" class="mr-article-section"><p class="mr-section-label">07 / PRIMARY SOURCES</p><h2>原始资料</h2><p class="mr-muted">想进一步了解，可以从本人的文章或访谈读起，再看具体研究。每项资料附有时间和来源；阅读实验结果时，也请留意它测试了哪些任务和环境。</p><ol class="mr-sources">{ids.map(id=><li><a href={sources[id].url}>{sources[id].title} ↗</a><span>{sources[id].date} · {sources[id].kind}</span></li>)}</ol></section>
        <nav class="mr-bottom-nav" aria-label="继续阅读"><a href={`${root}/routes/`}>← 返回路线总览</a><a href={`${root}/routes/${data.routes[(Number(number))%data.routes.length].id}/`}>下一条：{data.routes[(Number(number))%data.routes.length].person} →</a></nav>
      </div>
    </div>
  </main>
</MacroRouteLayout>
