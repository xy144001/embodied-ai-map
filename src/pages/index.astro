---
import BaseLayout from "../layouts/BaseLayout.astro";
const sections = [
  { key: "dexterous-hand", title: "灵巧手", owner: "@starrysky77", description: "手内操作、触觉感知、灵巧抓取与高自由度控制。" },
  { key: "dual-arm", title: "双臂", owner: "@xy144001", description: "双臂协同、装配、接触丰富操作与任务级规划。" },
  { key: "humanoid", title: "全身", owner: "@SyouSanGin", description: "移动操作、平衡、全身控制与通用人形机器人策略。" },
];
---
<BaseLayout>
  <main>
    <header class="hero">
      <p class="eyebrow">EMBODIED ROBOT LEARNING MAP</p>
      <h1>具身机器人技术地图</h1>
      <p>由三位维护者共同建设的模型、理论与系统实现知识库。</p>
    </header>
    <section class="grid" aria-label="知识分区">
      {sections.map((section) => (
        <article class="card">
          <span class="owner">{section.owner}</span>
          <h2>{section.title}</h2>
          <p>{section.description}</p>
          <a href={`${import.meta.env.BASE_URL}/${section.key}/`}>进入分区 →</a>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>
