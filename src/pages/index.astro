---
import BaseLayout from "../layouts/BaseLayout.astro";
const sections = [
  { key: "datasets", title: "数据集", owner: "@starrysky77", description: "具身数据集、采集系统、数据格式、规模与任务覆盖。", href: "datasets/dashboard.html" },
  { key: "model-architecture", title: "模型架构", owner: "@xy144001", description: "架构、问题、任务、机器人与拆解模型：从信息流理解模型，连接实验与硬件。", href: "model-architecture/index.html" },
  { key: "evaluation", title: "评测", owner: "@SyouSanGin", description: "评测基准、任务设计、指标体系、仿真与真实机器人测试。", href: "evaluation/" },
  { key: "macro-thinking", title: "宏观思想", owner: "@xiaoyazhai · @youchengcai", description: "由翟老师和蔡老师分别撰写具身智能宏观路线、研究范式与方向判断。", href: "macro-thinking/" },
];
---
<BaseLayout>
  <main>
    <header class="hero">
      <p class="eyebrow">EMBODIED ROBOT LEARNING MAP</p>
      <h1>具身机器人技术地图</h1>
      <p>由四位维护者共同建设的数据集、模型架构、评测与宏观思想知识库。</p>
    </header>
    <section class="grid" aria-label="知识分区">
      {sections.map((section) => (
        <article class="card">
          <span class="owner">{section.owner}</span>
          <h2>{section.title}</h2>
          <p>{section.description}</p>
          <a href={`${import.meta.env.BASE_URL}/${section.href}`}>进入分区 →</a>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>
